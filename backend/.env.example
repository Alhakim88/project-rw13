# =====================================================================
# File konfigurasi environment Backend RW 13
# SALIN file ini menjadi .env dan sesuaikan nilainya
# JANGAN pernah commit file .env ke Git!
# =====================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rw13_db
DB_USER=rw13_app
DB_PASSWORD=<PASSWORD_DB>
DB_CONNECTION_LIMIT=10

# --- JWT (JSON Web Token) ---
# Ganti dengan string acak yang panjang dan aman!
JWT_SECRET=<ISI_SECRET_ANDA>
JWT_EXPIRES_IN=8h

# --- CORS (asal frontend) ---
CORS_ORIGIN=http://localhost:5173

# --- Bcrypt ---
BCRYPT_ROUNDS=10
